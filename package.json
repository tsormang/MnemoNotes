{
  "name": "mnemonotes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "icons:notes:generate": "node scripts/generate-note-icon-catalog.mjs",
    "icons:roles:generate": "node scripts/generate-role-icon-catalog.mjs",
    "avatars:generate": "node scripts/generate-avatar-catalog.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:types": "supabase gen types --lang typescript --local > src/lib/database.types.ts",
    "admin:create": "node scripts/admin-create-from-env.mjs",
    "admin:only": "node scripts/admin-only.mjs",
    "setup:check": "node scripts/check-hosted.mjs",
    "setup:check-push": "node scripts/check-push-setup.mjs",
    "setup:generate-cron-secret": "node scripts/generate-cron-secret.mjs",
    "setup:bundle-sql": "node scripts/bundle-migrations.mjs",
    "setup:push-db": "node scripts/push-hosted-db.mjs",
    "setup:hosted": "powershell -ExecutionPolicy Bypass -File scripts/setup-hosted.ps1",
    "functions:deploy": "node scripts/deploy-functions.mjs",
    "android:icons": "node scripts/generate-android-icons.mjs",
    "build:android": "pnpm build && cap sync android",
    "android:open": "cap open android",
    "android:apk:debug": "cd android && gradlew.bat assembleDebug",
    "android:install-firebase": "powershell -ExecutionPolicy Bypass -File scripts/install-google-services.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/push-notifications": "^8.1.2",
    "@date-fns/tz": "^1.5.0",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/list": "^6.1.21",
    "@fullcalendar/multimonth": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@hookform/resolvers": "^5.9.1",
    "@sentry/react": "^10.71.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-query": "^5.102.5",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "i18next": "^25.10.10",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-i18next": "^16.6.6",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "supabase": "^2.115.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
