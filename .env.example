# Hosted Supabase (copy to .env.local — do not commit)

# Browser app (Vite)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Trusted scripts / Edge Functions only (never VITE_*)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Database password for non-interactive migrations (Dashboard → Database → Database password)
# SUPABASE_DB_PASSWORD=your-database-password

# Optional: Supabase CLI access token (npm run setup:hosted / npm run functions:deploy)
# SUPABASE_ACCESS_TOKEN=sbp_your_token_here

# Optional: error monitoring (production)
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-locally
